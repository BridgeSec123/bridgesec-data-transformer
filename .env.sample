DEBUG=True
OKTA_API_URL=your_Okta_API_URL
OKTA_API_TOKEN=your_Okta_API_Token
MONGO_DB_NAME=your_MongoDB_Database_Name
MONGO_URI=your_MongoDB_URI
CELERY_BROKER_URL=your_Celery_Broker_URL
OKTA_ISSUER=your_Okta_Issuer_URL
OKTA_CLIENT_ID=Your_Okta_Client_ID
OKTA_REDIRECT_URI=your_Okta_Redirect_URI
OKTA_SECRET_KEY=your_Okta_Secret_Key
FRONTEND_REDIRECT_URL=Your_Frontend_Redirect_URL
FRONTEND_URL=your_Frontend_URL
SERVER_URL=your_Terraform_Server_URL
# Chat feature (core/utils/chat_tools.py) self-calls the Django API it's running in.
# Local dev (manage.py runserver): http://localhost:8007
# Docker: http://localhost:8000 (the container's internal port — see docker-compose.yml)
BRIDGESEC_API_URL=http://localhost:8007

# AI chat model provider (/api/chat/) — see docs/CHAT_MODEL_PROVIDERS.md
CHAT_PROVIDER=anthropic          # anthropic | groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Logging backends — Elasticsearch/Splunk/Loki are each ONE shared instance
# (tenant picks which one via tenants.logging_backend, not its own server).
# Values below are for local `manage.py runserver` / host access, matching
# docker-compose.yml's local Splunk/Loki profiles. Inside the web/celery
# containers, docker-compose.yml overrides these with service-name URLs
# (e.g. http://splunk-server:8088) — see docker-compose.yml comments.
ELASTICSEARCH_URL=http://localhost:9200
SPLUNK_HEC_URL=http://localhost:8088
SPLUNK_HEC_TOKEN=your_splunk_hec_token
SPLUNK_SEARCH_URL=https://localhost:8089
SPLUNK_SEARCH_USER=admin
SPLUNK_SEARCH_PASSWORD=your_splunk_password
SPLUNK_VERIFY_SSL=False
LOKI_URL=http://localhost:3100
LOKI_VERIFY_SSL=False

SECRET_KEY=your_secret_key

# Supabase — all application data (users, tenants, roles, policies, logs)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Multi-tenancy — set to True to enable per-tenant MongoDB and Supabase routing.
# When False (default) all requests use the global MONGO_URI / SUPABASE_URL above.
# Per-tenant credentials are stored in the Supabase `tenants` table and configured
# via the UI (POST/PUT /api/tenants/).
MULTI_TENANCY_ENABLED=True

# Mapping provider — how long (seconds) to cache Supabase mapping tables in memory.
# Increase for high-traffic deployments; set to 0 to disable caching (not recommended).
MAPPINGS_CACHE_TTL_SEC=300

# ── Email notifications (Resend) ─────────────────────────────────────────────
# Get your API key from resend.com → API Keys.
# DEFAULT_FROM_EMAIL must be a verified sender domain in your Resend account.
# Recipients are configured per-tenant in Supabase notification_channels.config.recipients
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DIFF_ALERT_THRESHOLD=50


